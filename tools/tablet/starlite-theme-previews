#!/usr/bin/env python3
"""Render every theme once through wallust and emit Config/ThemePreviews.qml, so the
swatch grid can preview each theme's own colours without applying it (theming §7).
Run on the tablet; commit the output. Restores the theme that was active."""
import json, os, subprocess, sys
TOK = os.path.expanduser("~/.config/quickshell-starlite/tokens.json")
CS  = os.path.expanduser("~/.config/wallust/colorschemes")
themes = [  # id, label, wallust invocation
 ("ariadne","Ariadne",["wallust","cs",f"{CS}/ariadne.json"]),
 ("nord","Nord",["wallust","theme","Nord"]), ("nord-light","Nord Light",["wallust","theme","Nord-Light"]),
 ("gruvbox","Gruvbox",["wallust","theme","Gruvbox-Dark"]), ("gruvbox-light","Gruvbox Light",["wallust","theme","Gruvbox-Material-Light"]),
 ("tokyo-night","Tokyo Night",["wallust","theme","Tokyo-Night"]), ("tokyo-light","Tokyo Light",["wallust","theme","Tokyo-Night-Light"]),
 ("catppuccin","Catppuccin",["wallust","theme","Catppuccin-Mocha"]), ("latte","Latte",["wallust","theme","Catppuccin-Latte"]),
 ("dracula","Dracula",["wallust","theme","Dracula"]),
 ("everforest","Everforest",["wallust","theme","Everforest-Dark-Medium"]), ("everforest-light","Everforest Light",["wallust","theme","Everforest-Light-Medium"]),
 ("kanagawa","Kanagawa",["wallust","theme","Kanagawa-Wave"]), ("lotus","Lotus",["wallust","theme","Kanagawa-Lotus"]),
 ("one-dark","One Dark",["wallust","theme","One-Dark"]),
 ("solarized","Solarized",["wallust","theme","Solarized-Dark"]), ("solarized-light","Solarized Light",["wallust","theme","Solarized-Light"]),
 ("oxocarbon","Oxocarbon",["wallust","theme","Oxocarbon-Dark"]), ("paper","Paper",["wallust","theme","Paper"]),
]
before = open(TOK).read() if os.path.exists(TOK) else None
rows = []
for tid, label, cmd in themes:
    r = subprocess.run(cmd, capture_output=True, text=True)
    if r.returncode != 0: print("FAILED", tid, r.stderr[-200:], file=sys.stderr); continue
    t = json.load(open(TOK))
    rows.append((tid, label, cmd, t))
if before is not None: open(TOK, "w").write(before)
out = ["pragma Singleton", "import QtQuick", "", "// GENERATED by tools/tablet/starlite-theme-previews -- do not edit.",
       "// Each entry is what wallust produced for that theme, so swatches preview the real",
       "// colours and mock mode has a full palette without wallust installed.",
       "QtObject {", "    readonly property var list: ["]
for i, (tid, label, cmd, t) in enumerate(rows):
    out.append('        { id: "%s", label: "%s", cmd: %s, bg: "%s", fg: "%s", accent: "%s", critical: "%s", success: "%s" }%s'
               % (tid, label, json.dumps(cmd), t["background"], t["foreground"], t["accent"], t["critical"], t["success"],
                  "," if i < len(rows)-1 else ""))
out += ["    ]", "}", ""]
sys.stdout.write("\n".join(out))
print(f"{len(rows)} themes", file=sys.stderr)
